generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        Int      @id @default(autoincrement())
  name      String?
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Client {
  id               Int        @id @default(autoincrement())
  name             String
  password         String?
  username         String?    @unique
  labName          String?
  phone            String     @unique
  email            String?
  address          String?
  active           Boolean    @default(true)
  createdAt        DateTime   @default(now())
  expiredAt        DateTime?
  device           String?    @unique
  otp              Int?
  otpCount         Int?       @default(0)
  otpCreatedAt     DateTime?
  isVerified       Boolean?   @default(false)
  balance          Float      @default(0)
  whatsappMsgPrice Float?     @default(0.05)
  printCount       Int?       @default(0)
  platform         String?
  code             String?    @default("964")
  planId           Int
  lastActive       DateTime?
  isTestUpdated    Boolean?   @default(false)
  syncEnabled      Boolean    @default(false)
  maxDevices       Int        @default(1)
  // Manual admin override for device slots. When set, it takes precedence
  // over the auto-computed (1-per-operator) maxDevices value — see
  // helper/syncMaxDevices.js. Null means "auto" (the default).
  maxDevicesOverride Int?
  Plan             Plan       @relation(fields: [planId], references: [id])
  invoices         Invoice[]
  Wallet           Wallet[]
  whatsapp         Whatsapp[]
  devices          Device[]
  users            User[]
  usersWithHomeHere User[]    @relation("UserHomeClient")
}

model Device {
  id         Int       @id @default(autoincrement())
  clientId   Int
  userId     Int?
  machineId  String
  name       String?
  platform   String?
  lastSeenAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  Client     Client    @relation(fields: [clientId], references: [id])
  User       User?     @relation(fields: [userId], references: [id])

  @@unique([clientId, machineId])
}

// The actual login identity. Client is the lab/tenant (billing, plan,
// sync scope); User is who logs in — phone/OTP/password/device all live
// here now, so multiple operators can eventually exist per lab.
model User {
  id           Int       @id @default(autoincrement())
  clientId     Int
  name         String
  pin          String?
  role         String    @default("owner")
  phone        String    @unique
  password     String?
  username     String?   @unique
  device       String?   @unique
  platform     String?
  code         String?   @default("964")
  otp          Int?
  otpCount     Int?      @default(0)
  otpCreatedAt DateTime?
  isVerified   Boolean?  @default(false)
  lastActive   DateTime?
  createdAt    DateTime  @default(now())
  // The lab this user was originally created under. clientId can be
  // manually reassigned (support moves a user to work at a different lab's
  // client for a while); homeClientId stays fixed so "Leave This Lab" can
  // restore clientId back to where they actually belong.
  homeClientId Int?
  Client       Client    @relation(fields: [clientId], references: [id])
  HomeClient   Client?   @relation("UserHomeClient", fields: [homeClientId], references: [id])
  devices      Device[]
}

model Plan {
  id         Int       @id @default(autoincrement())
  name       String
  type       PlanType  @unique
  price      Int
  printLimit Int?
  createdAt  DateTime  @default(now())
  Active     Boolean   @default(true)
  clients    Client[]
  invoices   Invoice[]
}

model Invoice {
  id        Int         @id @default(autoincrement())
  planId    Int
  type      InvoiceType @default(CREATE)
  price     Float
  clientId  Int?
  createdAt DateTime    @default(now())
  client    Client?     @relation(fields: [clientId], references: [id])
  Plan      Plan        @relation(fields: [planId], references: [id])
}

// Report templates published from the admin dashboard. The whole design is
// the desktop app's template JSON (see dr.lab.beta src/templates/schema.js),
// stored opaquely in configJson; the scalar columns are for listing only.
model Template {
  id            Int      @id @default(autoincrement())
  name          String
  description   String   @default("")
  category      String   @default("General")
  language      String   @default("en")
  pageSize      String   @default("A4")
  orientation   String   @default("portrait")
  schemaVersion Int      @default(1)
  version       Int      @default(1)
  isPublished   Boolean  @default(false)
  configJson    Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Whatsapp {
  id            Int      @id @default(autoincrement())
  createdAt     DateTime @default(now())
  name          String?
  fileName      String?
  labName       String?
  messageId     Int?
  receiverPhone String
  senderPhone   String
  clientId      Int?
  Client        Client?  @relation(fields: [clientId], references: [id])
}

model Wallet {
  id               Int         @id @default(autoincrement())
  amount           Int
  whatsappMsgPrice Float?
  createdAt        DateTime    @default(now())
  type             PaymentType @default(BALANCE)
  clientId         Int
  Client           Client      @relation(fields: [clientId], references: [id])
}

// ---- Multi-PC sync mirror tables ----
// The server is a relay, not a source of truth: rows are keyed (clientId, uuid),
// cross-references are uuid strings without FK constraints (integrity is the
// desktop client's job), and `updatedAt` is the client-asserted LWW timestamp
// while `serverUpdatedAt` drives pull cursors.

model SyncPatient {
  id              Int       @id @default(autoincrement())
  clientId        Int
  uuid            String
  name            String
  gender          String?
  email           String?
  phone           String?
  birth           String?
  updatedAt       DateTime
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  serverUpdatedAt DateTime  @updatedAt

  @@unique([clientId, uuid])
  @@index([clientId, serverUpdatedAt])
}

model SyncDoctor {
  id              Int       @id @default(autoincrement())
  clientId        Int
  uuid            String
  name            String
  gender          String?
  email           String?
  phone           String?
  address         String?
  type            String?
  updatedAt       DateTime
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  serverUpdatedAt DateTime  @updatedAt

  @@unique([clientId, uuid])
  @@index([clientId, serverUpdatedAt])
}

// visit_v2 / visit_item_v2 are the tables the desktop app actually reads and
// writes today. The old SyncVisit mirror (for the dead "visits" table) was
// removed while still in dev — no installs had synced through it yet.
model SyncVisitV2 {
  id              Int       @id @default(autoincrement())
  clientId        Int
  uuid            String
  patientUuid     String?
  doctorUuid      String?
  visit_number    String?
  status          String?
  notes           String?
  gross_price_iqd Int?
  discount_iqd    Int?
  end_price_iqd   Int?
  paid_iqd        Int?
  payment_status  String?
  updatedAt       DateTime
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  serverUpdatedAt DateTime  @updatedAt

  @@unique([clientId, uuid])
  @@index([clientId, serverUpdatedAt])
}

model SyncVisitItemV2 {
  id              Int       @id @default(autoincrement())
  clientId        Int
  uuid            String
  visitUuid       String?
  test_id         Int?
  code            String?
  type            String?
  name_en         String?
  name_ar         String?
  sample_type     String?
  unit            String?
  ref_text        String?
  price_iqd       Int?
  meta_json       String?
  result_json     String?
  updatedAt       DateTime
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  serverUpdatedAt DateTime  @updatedAt

  @@unique([clientId, uuid])
  @@index([clientId, serverUpdatedAt])
}

model SyncTest {
  id              Int       @id @default(autoincrement())
  clientId        Int
  uuid            String
  name            String?
  price           Int?
  type            String?
  groupTest       String?
  normal          String?
  options         String?
  isSelecte       Int?
  updatedAt       DateTime
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  serverUpdatedAt DateTime  @updatedAt

  @@unique([clientId, uuid])
  @@index([clientId, serverUpdatedAt])
}

model SyncPackage {
  id              Int       @id @default(autoincrement())
  clientId        Int
  uuid            String
  title           String?
  customePrice    Int?
  updatedAt       DateTime
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  serverUpdatedAt DateTime  @updatedAt

  @@unique([clientId, uuid])
  @@index([clientId, serverUpdatedAt])
}

model SyncTestToPackage {
  id              Int       @id @default(autoincrement())
  clientId        Int
  uuid            String
  packageUuid     String?
  testUuid        String?
  updatedAt       DateTime
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  serverUpdatedAt DateTime  @updatedAt

  @@unique([clientId, uuid])
  @@index([clientId, serverUpdatedAt])
}

enum InvoiceType {
  CREATE
  UPDATE
  SUPPORT
}

enum PlanType {
  FREE
  SUBSCRIPTION
  PAID
}

enum PaymentType {
  BALANCE
}
